{
  "name": "renota-public",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Renota (睿记) public website — product pages for the Chrome extension, Zotero plugin and Android app",
  "scripts": {
    "build": "tsx src/build.ts",
    "dev": "tsx src/build.ts --serve",
    "preview": "tsx src/build.ts --serve",
    "typecheck": "tsc --noEmit",
    "design:lint": "designmd lint DESIGN.md",
    "design:tokens": "designmd export --format css-vars --prefix rn DESIGN.md",
    "crx:sync": "node scripts/sync-crx.mjs"
  },
  "devDependencies": {
    "@google/design.md": "^0.4.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.10.2",
    "cf": "^0.15.0",
    "markdown-it": "^14.1.0",
    "playwright": "^1.65.1",
    "tsx": "^4.19.2",
    "typescript": "^5.8.3",
    "wrangler": "^4.160.0"
  }
}
